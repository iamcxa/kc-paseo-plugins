+import Module, { createRequire } from "node:module";
+import { JSDOM } from "jsdom";
+import { act, createElement, forwardRef, useImperativeHandle, type ReactNode } from "react";
+import { createRoot } from "react-dom/client";
+import type { TestContext } from "node:test";
+import assert from "node:assert/strict";
+
+Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+const flatten = (s: any): any => Array.isArray(s) ? Object.assign({}, ...s.map(flatten)) : s ?? {};
+const element = forwardRef<any, any>((p, ref) => {
+  useImperativeHandle(ref, () => ({ scrollToEnd() {}, scrollTo() {} }));
+  return createElement("div", { role: p.accessibilityRole, "aria-label": p.accessibilityLabel, "aria-selected": p.accessibilityState?.selected, "data-lines": p.numberOfLines, style: flatten(p.style), onClick: p.disabled ? undefined : p.onPress }, p.children);
+});
+const input = (p: any) => createElement("textarea", { "aria-label": p.accessibilityLabel, value: p.value, onInput: (e: any) => p.onChangeText(e.target.value) });
+let current: any;
+let Bridge: any;
+const calls = new Map<string, (...args: any[]) => any>();
+export async function mountBridge(t: TestContext, compact = false, prepare?: (rpc: any) => void) {
+  const dom = new JSDOM("<!doctype html><div id='root'></div>");
+  Object.assign(globalThis, { window: dom.window, document: dom.window.document });
+  const container = dom.window.document.getElementById("root")!;
+  const root = createRoot(container);
+  const timers = new Map<number, { callback: () => void; ms: number }>();
+  let serial = 0;
+  t.mock.method(globalThis, "setInterval", (callback: () => void, ms: number) => { timers.set(++serial, { callback, ms }); return serial; });
+  t.mock.method(globalThis, "clearInterval", (id: number) => timers.delete(id));
+  const agents = ["a", "b"].map(id => ({ id, title: `${id.toUpperCase()} FO`, cwd: "/repo", status: "idle", updatedAt: "2026-11-03T10:00:00Z", labels: { role: "fo", repo: id, "workflow-dir": `/workflow-${id}` } }));
+  agents.push({ ...agents[0], id: "idle", title: "Research FO", labels: { role: "fo", repo: "research", "workflow-dir": "" } });
+  const records = new Map<string, any>();
+  const claims = new Map<string, any>();
+  const timeline = new Map<string, any[]>([["co", []], ["a", []], ["b", []]]);
+  const failures = new Set<string>();
+  const readFailures = new Set<string>();
+  const subscriptionFailures = new Set<string>();
+  const timelineListeners = new Map<string, Set<(event: any) => void>>();
+  const sent: { id: string; text: string }[] = [];
+  const sendOverrides = new Map<string, (text: string) => Promise<void>>();
+  const attempts = new Map<string, { stage: string; briefingId: string; title: string }>();
+  const briefing = (slug: string) => ({ briefingId: `brief-${slug}`, digest: `digest-${slug}`, slug, stage: "validation", question: `Approve ${slug}?`, artifacts: [{ summary: `Summary ${slug}`, markdown: "Evidence" }], ...attempts.get(slug) });
+  let deferred: ((value: any) => void) | null = null;
+  let hold = false;
+  const rpc: any = {
+    "coordinator.open": async () => ({ agentId: "co" }),
+    "tasks.read": async () => ({ tasks: {}, failedWorkflowDirs: [] }),
+    "gates.read": async () => ({ gates: agents.filter(a => a.id !== "idle").map(a => ({ ...briefing(a.id), title: attempts.get(a.id)?.title ?? `Approve ${a.id}?`, workflowDir: a.labels["workflow-dir"] })), failedWorkflowDirs: [] }),
+    "reviews.read": async () => ({ requests: [], checkedAt: 1, nextCheckAt: null, error: null }),
+    "gate.briefing": async ({ slug, stage, briefingId }: any) => { if (hold) { hold = false; return new Promise(resolve => { deferred = resolve; }); } return { briefing: briefing(slug).stage === stage ? briefing(slug) : null, recorded: records.get(briefingId) ?? records.get(slug) ?? null, error: null }; },
+    "decision.read": async ({ briefingId }: any) => ({ record: claims.get(briefingId) ?? null }),
+    "decision.claim": async (record: any) => { const full = { ...record, at: Date.now() }; claims.set(record.briefingId, full); return { claimed: true, record: full }; },
+    "decision.release": async () => ({}),
+  };
+  // RPC names are taken from the declarations so the fixture follows the host contract.
+  const require = createRequire(import.meta.url);
+  const { openCoordinator } = require("../../shared/coordinator");
+  const { readDecision, claimDecision, releaseDecision } = require("../../shared/decisions");
+  rpc[openCoordinator.name] = rpc["coordinator.open"];
+  rpc[readDecision.name] = rpc["decision.read"];
+  rpc[claimDecision.name] = rpc["decision.claim"];
+  rpc[releaseDecision.name] = rpc["decision.release"];
+  const listeners = new Map<string, Set<() => void>>();
+  const snapshots = new Set<(value: any) => void>();
+  const reads: { id: string; projection: string }[] = [];
+  const readOverrides = new Map<string, () => Promise<any>>();
+  const paseo = { agents: {
+    list: async () => ({ subscription: { subscribe: (h: any) => { snapshots.add(h.snapshot); h.snapshot({ entries: agents.map(agent => ({ agent })) }); }, release() {} } }),
+    ref: (id: string) => ({ status: "idle", subscribe: (fn: () => void) => { const set = listeners.get(id) ?? new Set(); set.add(fn); listeners.set(id, set); return () => set.delete(fn); }, send: async (text: string) => { sent.push({ id, text }); await sendOverrides.get(id)?.(text); }, timeline: {
+      refetch: async ({ projection }: any) => { reads.push({ id, projection }); const override = readOverrides.get(`${id}:${projection}`); if (override) return override(); if (failures.has(id) || readFailures.has(`${id}:${projection}`)) throw new Error(`Cannot read ${id}`); return { entries: timeline.get(id) ?? [], agent: { status: "idle" } }; },
+      subscribe: (fn: (event: any) => void) => { const set = timelineListeners.get(id) ?? new Set(); set.add(fn); timelineListeners.set(id, set); return Object.assign(() => set.delete(fn), { ready: subscriptionFailures.has(id) ? Promise.reject(new Error(`Subscription failed ${id}`)) : Promise.resolve() }); },
+    } }),
+  } };
+  prepare?.(rpc);
+  current = { paseo, rpc };
+  if (!Bridge) {
+    const loader = Module as any;
+    const original = loader._load;
+    const restore = t.mock.method(loader, "_load", function(this: unknown, id: string, ...args: unknown[]) {
+      if (id === "@getpaseo/plugin/client") return { usePaseo: () => current.paseo, useRpc: (r: any) => { if (!calls.has(r.name)) calls.set(r.name, (...values) => current.rpc[r.name](...values)); return calls.get(r.name); }, openExternalUrl: () => {} };
+      if (id === "@getpaseo/plugin/client/react-native") return { TextInput: input, Icon: () => null, Modal: Object.assign(() => null, { Content: element }) };
+      if (id === "react-native") return { Text: element, View: element, ScrollView: element, Pressable: element, Platform: { OS: "web" }, Keyboard: {}, PanResponder: { create: () => ({ panHandlers: {} }) } };
+      if (id === "./feedback-pressable") return { FeedbackPressable: element };
+      if (id === "./markdown-view") return { MarkdownView: ({ source }: { source: string }) => createElement("span", null, source) };
+      return original.call(this, id, ...args);
+    });
+    Bridge = require("../../client/bridge").Bridge;
+    restore.mock.restore();
+  }
+  const visible = (e: Element) => { for (let node: Element | null = e; node; node = node.parentElement) if ((node as HTMLElement).style?.display === "none") return false; return true; };
+  const find = (label: string) => [...container.querySelectorAll<HTMLElement>("[aria-label]")].find(e => e.getAttribute("aria-label") === label && visible(e));
+  const click = async (label: string) => { const node = find(label); assert.ok(node, `visible control: ${label}`); await act(async () => node.click()); };
+  const render = async () => { await act(async () => root.render(createElement(Bridge, { theme: { colors: {} }, layout: { compact, platform: "web" }, navigation: { openAgent() {} } }))); };
+  const text = () => [...container.querySelectorAll<HTMLElement>("div,span")].filter(e => visible(e) && !e.children.length).map(e => e.textContent).join("\n");
+  const type = async (label: string, value: string) => {
+    const node = find(label) as HTMLTextAreaElement; assert.ok(node, label);
+    await act(async () => {
+      Object.getOwnPropertyDescriptor(dom.window.HTMLTextAreaElement.prototype, "value")!.set!.call(node, value);
+      node.dispatchEvent(new dom.window.Event("input", { bubbles: true }));
+      node.dispatchEvent(new dom.window.Event("change", { bubbles: true }));
+    });
+  };
+  const poll = async () => { await act(async () => { for (const timer of [...timers.values()]) if (timer.ms === 15_000) timer.callback(); }); };
+  t.after(async () => { await act(() => root.unmount()); dom.window.close(); });
+  await render();
+  return { sendOverrides, readOverrides, readFailures, subscriptionFailures, emitTimeline: async (id: string, type: string) => { await act(async () => { for (const fn of [...timelineListeners.get(id) ?? []]) fn({ event: { type } }); }); }, agents, reads, publishAgents: async () => { await act(async () => { for (const snapshot of snapshots) snapshot({ entries: agents.map(agent => ({ agent })) }); }); }, deferBriefing: () => { hold = true; return async () => { assert.ok(deferred); await act(async () => deferred!({ briefing: briefing("a"), recorded: null, error: null })); }; }, refresh: async (id: string) => { await act(async () => { for (const fn of listeners.get(id) ?? []) fn(); await new Promise(resolve => setTimeout(resolve, 200)); }); }, pollGates: async () => { await act(async () => { for (const timer of [...timers.values()]) if (timer.ms === 60_000) timer.callback(); }); }, timers, attempts, click, find, type, text, poll, render, rpc, records, claims, sent, failures, timeline, container, briefing };
+}
diff --git a/spacedock-bridge/test/list-status.test.mts b/spacedock-bridge/test/list-status.test.mts
new file mode 100644
index 0000000..e06b410
--- /dev/null
+++ b/spacedock-bridge/test/list-status.test.mts
@@ -0,0 +1,25 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { itemStatus, filterCounts } from "../shared/list-status";
+
+ test("status priority covers every waiting kind in LIST-AND-DETAIL", () => {
+  const cases = [
+    [{ kind: "permission" }, "your-turn"], [{ kind: "gate" }, "your-turn"],
+    [{ kind: "gate", sent: true }, "waiting"], [{ kind: "gate", relayed: true }, "waiting"],
+    [{ kind: "gate", recorded: true }, "done"], [{ kind: "gate", closed: true }, "done"],
+    [{ kind: "ask" }, "your-turn"], [{ kind: "ask", source: "comms" }, "your-turn"],
+    [{ kind: "review", assigned: true }, "your-turn"], [{ kind: "review", assigned: false }, "your-turn"],
+    [{ kind: "ask", sourceState: "loading" }, "waiting"], [{ kind: "ask", sourceState: "failed" }, "check"],
+    [{ kind: "gate", tabClosed: true }, "your-turn"],
+    [{ kind: "gate", recorded: true, sent: true, sourceState: "failed" }, "check"],
+    [{ kind: "gate", recorded: true, sent: true }, "done"], [{ kind: "gate", overdue: true, relayed: true }, "check"],
+  ] as const;
+  for (const [input, expected] of cases) assert.equal(itemStatus(input).state, expected, JSON.stringify(input));
+ });
+ test("counts retain pending progress, exclude finished items and distinguish incomplete from zero", () => {
+  const items = [{ kind: "gate", sent: true }, { kind: "gate", relayed: true }, { kind: "gate", recorded: true }, { kind: "ask" }, { kind: "review", closed: true }] as const;
+  const sources = { fos: "loaded", gates: "loaded", reviews: "loaded", comms: "loaded" } as const;
+  assert.deepEqual(filterCounts(items, sources), { all: "3", permission: "0", review: "0", gate: "2", ask: "1" });
+  assert.deepEqual(filterCounts([], { ...sources, comms: "failed" }), { all: "?", permission: "0", review: "0", gate: "0", ask: "?" });
+  assert.equal(filterCounts(items, { ...sources, gates: "loading" }).gate, "2+");
+ });
diff --git a/spacedock-bridge/test/question-continuity.test.mts b/spacedock-bridge/test/question-continuity.test.mts
new file mode 100644
index 0000000..1b28a89
--- /dev/null
+++ b/spacedock-bridge/test/question-continuity.test.mts
@@ -0,0 +1,106 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { mountBridge } from "./helpers/bridge-host.mjs";
+
+type Host = Awaited<ReturnType<typeof mountBridge>>;
+function detail(h: Host): string {
+  let node: Element | null = h.find("Message A FO")!;
+  while (node && !node.querySelector('[aria-label="Back to list"]')) node = node.parentElement;
+  assert.ok(node);
+  return node.textContent!;
+}
+
+for (const source of ["label", "reply"] as const) {
+  for (const compact of [false, true]) {
+    test(`one officer asks two questions in turn, keeping recipient and draft (${source}, ${compact ? 360 : 1440})`, async t => {
+      const h = await mountBridge(t, compact);
+      const agent = h.agents[0];
+      const firstAt = new Date(Date.now() - 900_000).toISOString();
+      const secondAt = new Date(Date.now() - 180_000).toISOString();
+      const questions = ["Which release window? (you)", "Which rollback plan? (you)"];
+      if (source === "label") agent.labels = { ...agent.labels, "next-owner": "captain", next: questions[0] } as any;
+      else Object.assign(agent, { requiresAttention: true, attentionReason: "finished" });
+      Object.assign(agent, { updatedAt: source === "label" ? firstAt : new Date(Date.now() - 30_000).toISOString(), attentionTimestamp: source === "label" ? firstAt : null });
+      h.timeline.set("a", [{ seqStart: 1, timestamp: firstAt, item: { type: "assistant_message", text: `Next: ${questions[0]}` } }]);
+      await h.publishAgents();
+      if (compact) await h.click("Board");
+      await h.click(`${questions[0]} — A FO`);
+      await h.type("Message A FO", "Keep this officer discussion draft");
+      const original = h.find("Message A FO") as HTMLTextAreaElement;
+      await h.click("Back to Commander");
+      agent.updatedAt = source === "label" ? secondAt : new Date().toISOString();
+      if (source === "label") { Object.assign(agent, { attentionTimestamp: secondAt }); Object.assign(agent.labels, { next: questions[1] }); }
+      h.timeline.set("a", [{ seqStart: 2, timestamp: secondAt, item: { type: "assistant_message", text: `Next: ${questions[1]}` } }]);
+      await h.publishAgents();
+      if (compact) await h.click("Board");
+      await h.click(`${questions[1]} — A FO`);
+      assert.ok(h.find("Message A FO") !== original, "a new question has a distinct retained detail");
+      assert.ok(original.isConnected, "the first question's surface stays mounted");
+      assert.match(detail(h), /Which rollback plan/);
+      assert.doesNotMatch(detail(h), /Which release window/);
+      assert.match(detail(h), /waiting 3m/, "the detail uses the new question's own time");
+      assert.equal((h.find("Message A FO") as HTMLTextAreaElement).value, "Keep this officer discussion draft");
+      await h.click("Back to Commander"); if (compact) await h.click("Board");
+      const second = h.container.querySelectorAll('[aria-label="Message A FO"]');
+      await h.click(`${questions[1]} — A FO`);
+      assert.equal(h.container.querySelectorAll('[aria-label="Message A FO"]').length, second.length, "reopening the same question reuses its detail");
+      await h.click("Send to A FO");
+      assert.deepEqual(h.sent, [{ id: "a", text: "Keep this officer discussion draft" }]);
+    });
+  }
+}
+
+for (const changed of ["message", "timestamp"] as const) {
+  test(`an identical repeated question gets its own identity and time from its ${changed}`, async t => {
+    const h = await mountBridge(t);
+    const agent = h.agents[0];
+    Object.assign(agent, { requiresAttention: true, attentionReason: "finished" });
+    const firstAt = new Date(Date.now() - 900_000).toISOString();
+    const secondAt = new Date(Date.now() - 180_000).toISOString();
+    const question = "Choose the window (you)";
+    h.timeline.set("a", [{ ...(changed === "message" ? { seqStart: 10 } : {}), timestamp: firstAt, item: { type: "assistant_message", text: `Next: ${question}` } }]);
+    await h.publishAgents(); await h.click(`${question} — A FO`);
+    const original = h.find("Message A FO");
+    await h.type("Message A FO", "Repeated question draft"); await h.click("Back to Commander");
+    agent.updatedAt = new Date().toISOString();
+    h.timeline.set("a", [{ ...(changed === "message" ? { seqStart: 11 } : {}), timestamp: changed === "message" ? firstAt : secondAt, item: { type: "assistant_message", text: `Next: ${question}` } }]);
+    await h.publishAgents(); await h.click(`${question} — A FO`);
+    assert.ok(h.find("Message A FO") !== original);
+    assert.match(detail(h), changed === "message" ? /waiting 15m/ : /waiting 3m/);
+    assert.equal((h.find("Message A FO") as HTMLTextAreaElement).value, "Repeated question draft");
+  });
+}
+
+
+test("a repeated label question uses its new attention timestamp", async t => {
+  const h = await mountBridge(t); const agent = h.agents[0];
+  const firstAt = new Date(Date.now() - 900_000).toISOString();
+  const secondAt = new Date(Date.now() - 180_000).toISOString();
+  agent.labels = { ...agent.labels, "next-owner": "captain", next: "Repeat the choice? (you)" } as any;
+  Object.assign(agent, { updatedAt: firstAt, attentionTimestamp: firstAt });
+  await h.publishAgents(); await h.click("Repeat the choice? (you) — A FO");
+  const original = h.find("Message A FO"); await h.click("Back to Commander");
+  Object.assign(agent, { updatedAt: secondAt, attentionTimestamp: secondAt });
+  await h.publishAgents(); await h.click("Repeat the choice? (you) — A FO");
+  assert.ok(h.find("Message A FO") !== original); assert.match(detail(h), /waiting 3m/);
+});
+
+for (const source of ["label", "reply"] as const) {
+  test(`an unrelated officer activity update keeps the same question detail (${source})`, async t => {
+    const h = await mountBridge(t); const agent = h.agents[0];
+    const timestamp = new Date(Date.now() - 180_000).toISOString();
+    const question = "Keep the question open? (you)";
+    if (source === "label") agent.labels = { ...agent.labels, "next-owner": "captain", next: question } as any;
+    else Object.assign(agent, { requiresAttention: true, attentionReason: "finished" });
+    Object.assign(agent, { updatedAt: timestamp });
+    h.timeline.set("a", [{ seqStart: 10, timestamp, item: { type: "assistant_message", text: `Next: ${question}` } }]);
+    await h.publishAgents(); await h.click(`${question} — A FO`);
+    const original = h.find("Message A FO");
+    await h.type("Message A FO", "Same-question draft"); await h.click("Back to Commander");
+    agent.updatedAt = new Date().toISOString();
+    await h.publishAgents(); await h.click(`${question} — A FO`);
+    assert.ok(h.find("Message A FO") === original, "officer activity is not question identity");
+    assert.match(detail(h), /waiting 3m/);
+    assert.equal((original as HTMLTextAreaElement).value, "Same-question draft");
+  });
+}
diff --git a/spacedock-bridge/test/retained-readers.test.mts b/spacedock-bridge/test/retained-readers.test.mts
new file mode 100644
index 0000000..a5368f8
--- /dev/null
+++ b/spacedock-bridge/test/retained-readers.test.mts
@@ -0,0 +1,364 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { act } from "react";
+import { mountBridge } from "./helpers/bridge-host.mjs";
+
+type Host = Awaited<ReturnType<typeof mountBridge>>;
+const surfaces = [
+  { name: "gate briefing", mode: "gate", reader: "briefing", retry: "Retry briefing" },
+  { name: "gate conversation", mode: "gate", reader: "conversation", retry: "Retry conversation with A FO" },
+  { name: "assigned review conversation", mode: "review", reader: "conversation", retry: "Retry conversation with A FO" },
+  { name: "FO conversation", mode: "fo", reader: "conversation", retry: "Retry conversation with A FO" },
+  { name: "commander conversation", mode: "commander", reader: "conversation", retry: "Retry conversation with Comms officer" },
+  { name: "decision record", mode: "gate", reader: "claim", retry: "Retry decision record" },
+  { name: "relay status", mode: "gate", reader: "relay", retry: "Retry delivery status" },
+  { name: "commander question", mode: "commander", reader: "question", retry: "Retry conversation with Comms officer" },
+] as const;
+type Surface = typeof surfaces[number];
+const claim = { decisionId: "kept-decision", briefingId: "brief-a", slug: "a", foId: "a", decision: "approve", words: "准", at: Date.now() };
+const label = (s: Surface) => `Message ${s.mode === "commander" ? "Comms officer" : "A FO"}`;
+async function open(h: Host, s: Surface, shifted = false) {
+  if (s.mode === "review") {
+    h.rpc["reviews.read"] = async () => ({ requests: [{ owner: "org", repo: "a", number: 42, url: "https://github.com/org/a/pull/42", title: "Review the change", author: "author", firstSeenAt: 1 }], checkedAt: 1, nextCheckAt: null, error: null });
+    await h.pollGates(); await h.click(`Review the change — ${shifted ? "Shifted FO" : "A FO"}`); return;
+  }
+  if (s.mode === "commander") { await h.click("Commander"); return; }
+  if (s.mode === "fo") { await h.click("By FO"); await h.click(`Conversation with ${shifted ? "Shifted FO" : "A FO"}`); return; }
+  await h.click(`Approve a? — ${shifted ? "Shifted FO" : "A FO"}`);
+}
+async function away(h: Host, s: Surface) {
+  if (s.mode === "commander") await h.click("Approve b? — B FO");
+  else await h.click("Back to Commander");
+}
+function fault(h: Host, s: Surface) {
+  let broken = true;
+  if (s.reader === "briefing" || s.reader === "claim") {
+    const name = s.reader === "briefing" ? "gate.briefing" : "decisions.read";
+    const read = h.rpc[name];
+    h.rpc[name] = (input: unknown) => broken ? Promise.reject(new Error(`Unavailable ${s.name}`)) : read(input);
+  } else if (s.reader === "relay") h.readFailures.add("a:canonical");
+  else h.failures.add(s.mode === "commander" ? "co" : "a");
+  return () => { broken = false; h.failures.clear(); h.readFailures.clear(); };
+}
+
+for (const surface of surfaces) {
+  test(`retained surface table: ${surface.name} × identity changed upstream`, async t => {
+    const h = await mountBridge(t);
+    h.agents[0].labels = { ...h.agents[0].labels, task: "a" } as any;
+    const readBriefing = h.rpc["gate.briefing"];
+    const inputs: any[] = [];
+    h.rpc["gate.briefing"] = (input: any) => {
+      inputs.push(input);
+      return input.workflowDir === "/workflow-a" ? readBriefing(input) : Promise.resolve({ briefing: null, recorded: null, error: null });
+    };
+    if (surface.reader === "relay") h.claims.set("brief-a", claim);
+    await open(h, surface);
+    await h.type(label(surface), `Draft for ${surface.name}`);
+    const composer = h.find(label(surface));
+    await away(h, surface);
+    const gates = await h.rpc["gates.read"]({});
+    h.rpc["gates.read"] = async () => gates;
+    h.agents[0].labels["workflow-dir"] = "/moved-workflow";
+    h.agents[0].title = "Shifted FO";
+    h.rpc["coordinator.open"] = async () => ({ agentId: "replacement-co" });
+    await h.publishAgents(); await h.pollGates();
+    await open(h, surface, true); await h.poll();
+    assert.ok(h.find(label(surface)) === composer, "the retained recipient/title and composer must not change");
+    assert.equal((composer as HTMLTextAreaElement).value, `Draft for ${surface.name}`);
+    if (surface.mode === "gate") {
+      assert.ok(inputs.length > 1);
+      assert.ok(inputs.every(input => input.workflowDir === "/workflow-a" && input.slug === "a" && input.stage === "validation"));
+      assert.doesNotMatch(h.text(), /This gate is no longer open/);
+    }
+    await h.click(`Send to ${surface.mode === "commander" ? "Comms officer" : "A FO"}`);
+    assert.equal(h.sent.at(-1)?.id, surface.mode === "commander" ? "co" : "a");
+  });
+  for (const recovery of ["reactivate", "retry control"]) {
+    test(`retained surface table: ${surface.name} × failed read then ${recovery}`, async t => {
+      const h = await mountBridge(t);
+      if (surface.reader === "relay") h.claims.set("brief-a", claim);
+      const restore = fault(h, surface);
+      if (surface.mode === "commander") await h.refresh("co");
+      await open(h, surface);
+      await h.type(label(surface), `Keep ${surface.name}`);
+      const composer = h.find(label(surface));
+      if (recovery === "retry control") assert.ok(h.find(surface.retry), "each failed reader offers a visible retry");
+      else assert.match(h.text(), /Unavailable|Cannot read|Could not read/, "the reader actually failed before the detour");
+      restore();
+      h.timeline.set(surface.mode === "commander" ? "co" : "a", [{ seqStart: 1, item: { type: "assistant_message", text: "Recovered conversation" } }]);
+      if (surface.reader === "relay") h.timeline.set("a", [{ seqStart: 1, item: { type: "user_message", text: claim.decisionId } }]);
+      if (recovery === "reactivate") { await away(h, surface); await open(h, surface); }
+      else await h.click(surface.retry);
+      assert.ok(h.find(label(surface)) === composer, "the mounted composer is retained");
+      assert.equal((composer as HTMLTextAreaElement).value, `Keep ${surface.name}`);
+      assert.ok(!h.find(surface.retry), "successful read clears its own failure");
+      assert.doesNotMatch(h.text(), /Cannot read|Unavailable|Could not check/);
+      if (surface.reader === "relay") assert.match(h.text(), /Relayed to A FO/);
+      else if (surface.reader === "conversation" || surface.reader === "question") assert.match(h.text(), /Recovered conversation/);
+      else assert.ok(h.find("Choose 准"));
+      assert.equal(h.sent.length, 0, "retry only reads");
+    });
+  }
+}
