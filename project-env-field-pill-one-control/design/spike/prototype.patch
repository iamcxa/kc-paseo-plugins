diff -ruN a/shared/ref.ts b/shared/ref.ts
--- a/shared/ref.ts	1970-01-01 08:00:00
+++ b/shared/ref.ts	2026-10-22 13:11:46
@@ -0,0 +1,38 @@
+export interface ParsedRef {
+  vault: string;
+  item: string;
+  field: string;
+}
+
+export function parseRef(ref: string): ParsedRef | null {
+  if (!ref.startsWith("op://")) return null;
+  const parts = ref.slice("op://".length).split("/");
+  if (parts.length < 3 || parts.some((part) => part.trim() === "")) return null;
+  return { vault: parts[0], item: parts[1], field: parts[parts.length - 1] };
+}
+
+export type PillView =
+  | { kind: "empty" }
+  | { kind: "raw"; text: string }
+  | { kind: "ref"; vault: string | null; item: string; field: string; differs: boolean };
+
+export function pillView(ref: string, variableName: string, vault: string): PillView {
+  if (ref === "") return { kind: "empty" };
+  const parsed = parseRef(ref);
+  if (parsed === null) return { kind: "raw", text: ref };
+  return {
+    kind: "ref",
+    vault: parsed.vault === vault ? null : parsed.vault,
+    item: parsed.item,
+    field: ref.slice("op://".length).split("/").slice(2).join(" / "),
+    differs: parsed.field !== variableName,
+  };
+}
+
+export function typedRefError(text: string): string | null {
+  return parseRef(text.trim()) === null ? "A reference looks like op://vault/item/field" : null;
+}
+
+export function rpcReason(message: string): string {
+  return message.replace(/^Request failed:\s*/, "").replace(/\s+requestType=.*$/s, "").trim();
+}
